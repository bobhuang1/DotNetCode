<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ShopMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ShopMobile"
    Title="Silk &amp; Loom">

    <ShellContent
        Title="Browse"
        ContentTemplate="{DataTemplate local:BrowsePage}"
        Route="Browse" />

    <ShellContent
        Title="Cart"
        ContentTemplate="{DataTemplate local:CartPage}"
        Route="Cart" />

    <ShellContent
        Title="My Order"
        ContentTemplate="{DataTemplate local:OrderStatusPage}"
        Route="OrderStatus" />

</Shell>
