<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ShopMobile"
             x:Class="ShopMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentColor">#6A3FA0</Color>
            <Color x:Key="InkColor">#2B2B33</Color>
            <Color x:Key="PaperColor">#FAF8F5</Color>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource InkColor}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
