<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopMobile.OrderStatusPage"
             Title="Order Status">
    <VerticalStackLayout Padding="16" Spacing="12" BackgroundColor="{StaticResource PaperColor}">
        <Label Text="Look up an order" FontSize="20" FontAttributes="Bold" />
        <Entry x:Name="OrderNumberEntry" Placeholder="SO-2026-7KQ2M9XA" />
        <Entry x:Name="EmailEntry" Placeholder="Email used for the order" Keyboard="Email" />
        <Button Text="Look up" Clicked="OnLookUpClicked" />

        <Label x:Name="ResultLabel" Text="" LineBreakMode="WordWrap" />
    </VerticalStackLayout>
</ContentPage>
